# The SPA for the local all-in-one stack: build with bun, serve the static output with nginx.
#
# Lives here rather than in web/ because web/ is a MIRRORED COPY of the Node repo's frontend -
# scripts/sync-web.ps1 runs robocopy /MIR over it, so anything added inside would be deleted on
# the next sync. Everything this stack adds sits outside that directory.
#
# It does not reuse web/Dockerfile.prod either: that image carries the certbot and TLS
# machinery for invoicemg.in, which a localhost stack has no use for and which refuses to start
# without a certificate.

FROM oven/bun:1-alpine AS build
WORKDIR /app

# Dependencies first, as their own layer: they change far less often than the source, so a
# normal edit reuses the cached install instead of resolving the tree again.
COPY web/package.json web/bun.lock* ./
RUN bun install --frozen-lockfile

COPY web/ .

# Baked into the bundle at build time - every VITE_ variable is, which is why setting one on
# the running container does nothing.
#
# "/api" is deliberately RELATIVE: nginx in the final stage proxies /api to the Go service, so
# the bundle carries no hostname and works whether you open it as localhost, a LAN address, or
# anything else. It is also why there is no CORS configuration anywhere in this stack - the
# browser only ever sees one origin.
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL

RUN bun run build

FROM nginx:1.27-alpine
COPY --from=build /app/build /usr/share/nginx/html
COPY deploy/nginx.local.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
